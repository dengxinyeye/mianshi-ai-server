# ===================================================================
# 环境变量模板
#
# 使用方式：
#   cp .env.example .env.development     # 本地开发
#   cp .env.example .env.production      # 生产部署
# 然后填入真实值。这两个文件已被 .gitignore 忽略，切勿提交到仓库。
# ===================================================================

# ---------- 运行环境 ----------
NODE_ENV=development
PORT=8888

# ---------- 数据库 ----------
# 本地 MongoDB 示例：mongodb://127.0.0.1:27017/mianshi-ai
# 云端请使用带鉴权的连接串，账号密码不要硬编码在代码中
MONGODB_URI=mongodb://127.0.0.1:27017/mianshi-ai

# ---------- JWT 鉴权 ----------
# 必填。服务启动时会强制校验，缺失将直接启动失败。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- DeepSeek 大模型 ----------
# 必填。在 https://platform.deepseek.com 申请。
# 缺失时服务可启动，但所有 AI 功能不可用。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=4096
